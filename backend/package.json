{
  "name": "@genesis/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --ignore \"**/*.db\" --ignore \"**/*.db-journal\" src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "jest",
    "test:unit": "jest --testMatch='**/__tests__/unit/**/*.test.ts'",
    "test:integration": "jest --runInBand --testMatch='**/__tests__/integration/**/*.test.ts'",
    "test:e2e": "jest --testMatch='**/__tests__/e2e/**/*.test.ts'"
  },
  "dependencies": {
    "@genesis/engine": "*",
    "@genesis/shared": "*",
    "@prisma/client": "^5.10.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "pino": "^8.19.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.19",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.10.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
